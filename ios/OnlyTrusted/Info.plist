<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>OnlyTrusted</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.2.0</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>NSFaceIDUsageDescription</key>
    <string>OnlyTrusted uses Face ID to unlock the app and the family vault.</string>
    <!-- Voice Biometric Trusted Contact Verification (Elite). The microphone is used
         exclusively to (a) enroll a trusted contact's 10-second voice sample during
         setup, and (b) sample 2 seconds of a live call to detect AI-cloned voices.
         Audio is never persisted — only a 20-dim MFCC feature vector is kept in the
         Keychain. No network. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Elite uses the microphone only to enroll a trusted contact's voice sample and to detect AI-cloned deepfake callers during a live call. Raw audio is never stored or uploaded — only a 20-number mathematical fingerprint lives on-device.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>OnlyTrusted scans nearby Bluetooth trackers to flag any device that may be following you.</string>
    <key>NSCameraUsageDescription</key>
    <string>Elite checks faces only in-memory to detect if someone else is looking at your screen. No images are stored. The camera is also used to scan QR codes for Smart Link Guard.</string>
    <!-- Geo-fence Auto-Lock (Elite). Background region monitoring requires the "Always"
         authorization — "While using the app" would silently drop didExitRegion when the
         scene is in the background, which defeats the entire feature. -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Elite uses your location only to detect when your phone leaves all trusted locations — nothing is sent to any server.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Elite uses your location only to detect when your phone leaves all trusted locations — nothing is sent to any server.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>Elite uses your location only to detect when your phone leaves all trusted locations — nothing is sent to any server.</string>
    <!-- Required for Geo-fence Auto-Lock (Elite) to receive didExitRegion callbacks while
         the app is in the background. Trade-off: iOS shows the Always location prompt and
         may occasionally wake the app in the background to deliver the exit event. We never
         run a continuous background location session; CoreLocation only wakes us for region
         crossings. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
    </array>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>callerid</string>
        <string>com.att.mobilesecurity</string>
        <string>vzcallfilter</string>
        <string>tel</string>
        <string>sms</string>
    </array>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
</dict>
</plist>
