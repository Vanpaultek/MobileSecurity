<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core permissions -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- READ_PHONE_STATE: required by the SIM-Swap Alarm (Pro) to read SIM serial + IMSI +
         carrier operator for fingerprinting the current SIM so we can detect a swap.
         Also used by caller-id lookups. On Android 10+ IMSI/getSubscriberId often requires
         carrier privilege; we fall back to SIM serial + operator in that case. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Required by Duress Mode (Pro). We fire a silent SOS SMS via SmsManager when the
         duress PIN is entered at the lock screen. We NEVER send SMS otherwise. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- No FGS types of microphone/camera declared anymore: SensorMonitorService only
         OBSERVES other apps' use via SensorPrivacyManager / registerAudioRecordingCallback
         / registerAvailabilityCallback and doesn't itself hold RECORD_AUDIO / CAMERA. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required by Tracker Finder (Pro) on Android 14+ for the continuous background
         BLE scan foreground service type. Only started when the user opts in. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Tracker Finder (Pro): BLE scan for AirTag / Tile / Samsung SmartTag / unknown
         trackers. BLUETOOTH_SCAN replaces the pre-S location requirement for callers
         that declare neverForLocation (we never derive the user's position). CONNECT
         is needed to read advertisement device names when they are present. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Pre-S fallback: BLE scans on Android 11 and below return nothing without fine
         location. We request it at runtime from the Tracker Finder screen on those
         releases only. Omitted on 12+ via maxSdkVersion so Play Store listing scope
         stays tight. -->
    <!-- Geo-fence Auto-Lock (Elite). Required to register CLCircularRegion-style
         geofences via GeofencingClient. ACCESS_FINE_LOCATION is requested at runtime
         from the Geofence setup screen on all API levels; also used by Tracker Finder
         on Android 11 and below (12+ uses BLUETOOTH_SCAN w/ neverForLocation instead).
         ACCESS_BACKGROUND_LOCATION lets exit events fire while the app is in the
         background — without it the GeofencingClient callbacks drop. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!--
      Required for the user-facing Permission Watchdog feature in OnlyTrusted — audits
      other apps' sensitive permissions on the user's device, no network use. The feature
      is Pro-gated and runs entirely on-device.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.sensor.proximity" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:name=".OnlyTrustedApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnlyTrusted"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OnlyTrusted">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.lock.PocketConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.OnlyTrusted" />

        <!-- Sensor monitor (observes OTHER apps' mic + camera use via SensorPrivacyManager /
             AudioManager.registerAudioRecordingCallback / CameraManager.registerAvailabilityCallback).
             This service does NOT record audio or capture video itself, so Android 14+'s
             foregroundServiceType=microphone / camera would be mis-declared and would require
             RECORD_AUDIO / CAMERA permissions we don't need. Use specialUse only. -->
        <service
            android:name=".services.SensorMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Privacy sensor monitoring: alerts the user when mic or camera is accessed by other apps." />
        </service>

        <!-- Pocket detection service -->
        <service
            android:name=".services.PocketDetectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pocket-dial prevention using proximity and motion sensors." />
        </service>

        <!-- Watermark overlay service -->
        <service
            android:name=".services.WatermarkOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated screen watermark that tags screenshots with a per-session code so the owner can trace leaks." />
        </service>

        <!-- Call screening service -->
        <service
            android:name=".services.CallBlockerService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- SMS receiver -->
        <receiver
            android:name=".services.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Lock-state receiver -->
        <receiver
            android:name=".services.LockStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_OFF" />
            </intent-filter>
        </receiver>

        <!-- Boot receiver (restart foreground services) -->
        <receiver
            android:name=".services.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Wangiri (one-ring-hangup) watcher. Started from the app on launch when the user
             is on Pro and the feature is enabled. Observes TelephonyManager call-state only;
             we don't survive process death — the user re-opens the app to resume observation. -->
        <service
            android:name=".ui.wangiri.WangiriWatcherService"
            android:exported="false" />

        <!-- Tracker Finder (Pro) foreground service. Runs a short BLE scan every 15 minutes
             while continuous mode is enabled, so the "3+ sessions over >15 min" classifier
             in TrackerFinderStore has data to work with. Only started by the user via the
             Tracker Finder screen; stops itself if the Pro gate lapses. -->
        <service
            android:name=".ui.trackerfinder.TrackerFinderService"
            android:exported="false"
            android:foregroundServiceType="location">
        </service>

        <!-- Safety Check-In daily nag receiver. Fires once per day at the owner's chosen time
             via AlarmManager.setInexactRepeating. Posts a reminder if the owner hasn't tapped
             "I'm safe" in the preceding 24 h. -->
        <receiver
            android:name=".ui.checkin.CheckInNagReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.onlytrusted.app.action.CHECKIN_NAG" />
            </intent-filter>
        </receiver>

        <!-- Smart Link Guard (Pro): inspects incoming SMS for URL-shaped substrings and
             runs each through the 100%-on-device rules engine. Fires only when the user
             is on Pro AND the Smart Link Guard SMS toggle is on; otherwise no-ops. -->
        <receiver
            android:name=".ui.smartlinkguard.SmartLinkGuardSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="900">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Smart Link Guard QR scanner. Launched from the Smart Link Guard screen via
             an ActivityResultContract; returns the detected URL to the caller. -->
        <activity
            android:name=".ui.smartlinkguard.SmartLinkGuardQrActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OnlyTrusted" />

        <!-- Geo-fence Auto-Lock (Elite): GeofencingClient delivers transition events
             (we only register the EXIT transition) to this receiver via a PendingIntent.
             exported=false — only Play Services sends to it. -->
        <receiver
            android:name=".geofence.GeofenceBroadcastReceiver"
            android:exported="false" />

    </application>

</manifest>
