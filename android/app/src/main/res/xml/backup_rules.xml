<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy Auto Backup rules (used on API < 31). We deny EVERYTHING by excluding both the
  database domain and the whole sharedpref domain. Our data is designed to live only on this
  device; a cloud copy via Auto Backup would defeat the point of SQLCipher + Keystore.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
